<!DOCTYPE html>
<html lang="es">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Credencial GAMLL - Modelo</title>
<style>
  :root {
    --verde:#075b35;
    --verde2:#087744;
    --verde-claro:#4f8f70;
    --gris:#eef3ef;
    --texto:#183b2b;
  }
  * { box-sizing:border-box; }
  body {
    margin:0;
    min-height:100vh;
    display:flex;
    align-items:center;
    justify-content:center;
    padding:24px;
    background:linear-gradient(135deg,#e9eeeb,#f8faf9);
    font-family:Arial,Helvetica,sans-serif;
    color:var(--texto);
  }
  .contenedor {
    width:min(100%, 490px);
  }
  .credencial {
    position:relative;
    width:100%;
    aspect-ratio:2 / 3;
    overflow:hidden;
    border-radius:22px;
    background:#fff;
    border:1px solid #d8dedb;
    box-shadow:0 12px 35px rgba(0,0,0,.15);
  }
  /* bandas curvas superiores e inferiores */
  .curva-superior {
    position:absolute;
    top:-38px;
    right:-45px;
    width:180px;
    height:95px;
    border-radius:0 0 0 100%;
    background:var(--verde);
    transform:rotate(16deg);
  }
  .curva-superior::after {
    content:"";
    position:absolute;
    top:10px;
    left:-10px;
    width:185px;
    height:70px;
    border-radius:0 0 0 100%;
    border-top:10px solid #4b9c72;
  }
  .franja-inferior {
    position:absolute;
    left:-8%;
    bottom:-2%;
    width:116%;
    height:105px;
    background:var(--verde);
    clip-path:ellipse(72% 65% at 50% 100%);
    z-index:1;
  }
  .franja-inferior::before {
    content:"";
    position:absolute;
    left:-2%;
    bottom:36px;
    width:104%;
    height:42px;
    background:#fff;
    clip-path:ellipse(70% 75% at 50% 100%);
  }
  .franja-inferior::after {
    content:"";
    position:absolute;
    left:-2%;
    bottom:31px;
    width:104%;
    height:34px;
    background:#4d936e;
    clip-path:ellipse(70% 75% at 50% 100%);
    opacity:.95;
  }

  .contenido {
    position:relative;
    z-index:3;
    height:100%;
    padding:28px 31px 24px;
  }
  .cabecera {
    display:flex;
    align-items:center;
    gap:14px;
    margin-right:28px;
  }
  .escudo {
    width:103px;
    height:103px;
    object-fit:contain;
    flex:none;
  }
  .separador {
    width:3px;
    height:97px;
    background:var(--verde);
    border-radius:2px;
  }
  .institucion {
    line-height:1.05;
  }
  .institucion .gob {
    font-weight:700;
    font-size:18px;
    letter-spacing:.2px;
  }
  .institucion .municipal {
    font-size:29px;
    font-weight:800;
    color:var(--verde);
  }
  .institucion .de {
    font-size:27px;
    letter-spacing:.5px;
  }

  .sigla {
    margin:16px 0 10px;
    display:flex;
    align-items:center;
    gap:17px;
    color:var(--verde);
    font-size:25px;
    font-weight:800;
    letter-spacing:7px;
  }
  .sigla::before,.sigla::after {
    content:"";
    height:2px;
    flex:1;
    background:#4d856a;
  }
  .sigla span { white-space:nowrap; }

  .foto-wrap {
    width:178px;
    height:185px;
    margin:0 auto 16px;
    padding:7px;
    border:3px solid var(--verde);
    border-radius:17px;
    background:#fff;
  }
  .foto {
    width:100%;
    height:100%;
    display:block;
    object-fit:cover;
    border-radius:10px;
  }

  .datos {
    display:flex;
    flex-direction:column;
    gap:9px;
  }
  .fila {
    display:grid;
    grid-template-columns:42px 1fr;
    align-items:center;
    gap:9px;
  }
  .icono {
    width:39px;
    height:39px;
    border-radius:50%;
    background:var(--verde);
    display:grid;
    place-items:center;
    color:#fff;
    font-size:20px;
    box-shadow:inset 0 0 0 2px rgba(255,255,255,.15);
  }
  .campo label {
    display:block;
    margin-bottom:3px;
    color:var(--verde);
    font-size:12px;
    font-weight:700;
    letter-spacing:.3px;
  }
  .campo input {
    width:100%;
    height:28px;
    border:1.5px solid #75a88f;
    border-radius:6px;
    padding:4px 8px;
    outline:none;
    color:#333;
    background:#fff;
    font-size:13px;
  }
  .campo input:focus {
    border-color:var(--verde);
    box-shadow:0 0 0 2px rgba(7,91,53,.12);
  }
  .fila-ci .campo { max-width:198px; }

  .qr {
    position:absolute;
    right:30px;
    bottom:102px;
    width:95px;
    text-align:center;
    z-index:4;
  }
  .qr-box {
    width:95px;
    height:95px;
    padding:7px;
    background:#fff;
    border:2px solid var(--verde);
    border-radius:9px;
    display:grid;
    place-items:center;
  }
  .qr-box canvas,.qr-box img { width:100%!important;height:100%!important; }
  .qr small {
    display:block;
    margin-top:5px;
    font-size:7px;
    color:#28543e;
    font-weight:700;
  }

  .marca {
    position:absolute;
    left:34px;
    bottom:105px;
    z-index:4;
    color:var(--verde);
    font-family:cursive;
    font-size:18px;
    font-weight:700;
    font-style:italic;
  }
  .lema {
    display:block;
    font-family:Arial,sans-serif;
    font-size:8px;
    font-weight:400;
    margin-top:0;
    letter-spacing:.2px;
  }
  .pie {
    position:absolute;
    bottom:9px;
    left:0;
    width:100%;
    z-index:5;
    color:#fff;
    display:flex;
    justify-content:center;
    align-items:center;
    gap:14px;
    font-weight:800;
    letter-spacing:4px;
    font-size:17px;
  }
  .pie::before,.pie::after {
    content:"";
    width:82px;
    height:2px;
    background:rgba(255,255,255,.8);
  }

  .controles {
    margin-top:18px;
    display:flex;
    gap:8px;
    flex-wrap:wrap;
    justify-content:center;
  }
  button {
    border:0;
    border-radius:9px;
    padding:10px 14px;
    background:var(--verde);
    color:#fff;
    cursor:pointer;
    font-weight:700;
  }
  button:hover { background:#06492b; }
  .ayuda {
    margin-top:8px;
    text-align:center;
    color:#65736b;
    font-size:12px;
  }

  @media (max-width:430px) {
    body { padding:10px; }
    .contenido { padding:21px 22px 20px; }
    .escudo { width:78px;height:78px; }
    .separador { height:75px; }
    .institucion .gob { font-size:13px; }
    .institucion .municipal { font-size:22px; }
    .institucion .de { font-size:21px; }
    .sigla { font-size:19px; margin-top:12px; letter-spacing:5px; }
    .foto-wrap { width:145px;height:150px;margin-bottom:13px; }
    .fila { grid-template-columns:35px 1fr; }
    .icono { width:34px;height:34px;font-size:17px; }
    .campo label { font-size:10px; }
    .campo input { height:26px;font-size:12px; }
    .qr { right:20px;bottom:87px;width:78px; }
    .qr-box { width:78px;height:78px; }
    .marca { left:23px;bottom:90px;font-size:15px; }
    .pie { font-size:13px;gap:9px;letter-spacing:3px; }
    .pie::before,.pie::after { width:55px; }
    .franja-inferior { height:92px; }
  }

  @media print {
    body { padding:0;background:#fff; }
    .controles,.ayuda { display:none; }
    .credencial { box-shadow:none;border:0; }
  }
</style>
</head>
<body>
<div class="contenedor">
  <div class="credencial" id="credencial">
    <div class="curva-superior"></div>
    <div class="franja-inferior"></div>

    <main class="contenido">
      <header class="cabecera">
        <img class="escudo" src="data:image/png;base64," alt="Escudo de Llallagua">
        <div class="separador"></div>
        <div class="institucion">
          <div class="gob">GOBIERNO AUTÓNOMO</div>
          <div class="municipal">MUNICIPAL</div>
          <div class="de">DE LLALLAGUA</div>
        </div>
      </header>

      <div class="sigla"><span>GAMLL</span></div>

      <div class="foto-wrap">
        <img id="foto" class="foto" src="data:image/png;base64," alt="Fotografía">
      </div>

      <section class="datos">
        <div class="fila">
          <div class="icono">●</div>
          <div class="campo">
            <label>NOMBRES Y APELLIDOS:</label>
            <input id="nombre" value="Lic. David Cruz Paco">
          </div>
        </div>

        <div class="fila">
          <div class="icono">▣</div>
          <div class="campo">
            <label>CARGO:</label>
            <input id="cargo" value="Alcalde">
          </div>
        </div>

        <div class="fila fila-ci">
          <div class="icono">▤</div>
          <div class="campo">
            <label>C.I.:</label>
            <input id="ci" value="">
          </div>
        </div>
      </section>
    </main>

    <div class="qr">
      <div class="qr-box" id="qrcode"></div>
      <small>Verificación de credencial</small>
    </div>

    <div class="marca">
      Llallagua
      <span class="lema">nuestra gente, nuestro compromiso</span>
    </div>

    <div class="pie">GAMLL</div>
  </div>

  <div class="controles">
    <button type="button" onclick="document.getElementById('fotoInput').click()">Cambiar foto</button>
    <button type="button" onclick="window.print()">Imprimir</button>
  </div>
  <input id="fotoInput" type="file" accept="image/*" hidden>
  <div class="ayuda">Los campos son editables. El QR se actualiza automáticamente con los datos.</div>
</div>

<script>
  // QR sencillo usando una imagen externa. Si no hay Internet, se conserva el recuadro.
  function actualizarQR() {
    const nombre = document.getElementById('nombre').value;
    const cargo = document.getElementById('cargo').value;
    const ci = document.getElementById('ci').value;
    const texto = encodeURIComponent(
      'GAMLL|Nombre:' + nombre + '|Cargo:' + cargo + '|CI:' + ci
    );
    const box = document.getElementById('qrcode');
    box.innerHTML = '<img alt="Código QR" src="https://api.qrserver.com/v1/create-qr-code/?size=180x180&data=' + texto + '">';
  }

  document.querySelectorAll('.campo input').forEach(input => {
    input.addEventListener('input', actualizarQR);
  });

  document.getElementById('fotoInput').addEventListener('change', function(e) {
    const archivo = e.target.files[0];
    if (!archivo) return;
    const lector = new FileReader();
    lector.onload = () => document.getElementById('foto').src = lector.result;
    lector.readAsDataURL(archivo);
  });

  actualizarQR();
</script>
</body>
</html>
